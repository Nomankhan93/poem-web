# Public Supabase browser/server configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Required for /admin/users invitations.
# NEVER prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Canonical production origin used by robots.txt and sitemap.xml.
# Example: https://example.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000
